# Generated by agents-cli 1.11.0 (infra single-project).

terraform {
  required_version = ">= 1.6"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 7.4"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

resource "google_project_service" "services" {
  for_each = toset([
    "aiplatform.googleapis.com",
    "cloudtrace.googleapis.com",
    "logging.googleapis.com",
    "telemetry.googleapis.com",
  ])
  service            = each.value
  disable_on_destroy = false
}

resource "google_vertex_ai_reasoning_engine" "app" {
  display_name = var.project_name
  region       = var.region

  spec {
    identity_type = "AGENT_IDENTITY"
    deployment_spec {
      env {
        name  = "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT"
        value = "false"
      }
    }
  }

  lifecycle {
    ignore_changes = [spec[0].package_spec, spec[0].source_code_spec, spec[0].deployment_spec]
  }

  depends_on = [google_project_service.services]
}

output "reasoning_engine_id" {
  value = google_vertex_ai_reasoning_engine.app.id
}
