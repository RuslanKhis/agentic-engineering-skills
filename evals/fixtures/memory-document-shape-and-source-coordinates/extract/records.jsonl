{"record_id": "r001", "document": "DMP", "version": "v3", "page": 14, "kind": "heading", "clause_path": ["4"], "label": "4", "text": "4 Design and amenity"}
{"record_id": "r002", "document": "DMP", "version": "v3", "page": 14, "kind": "clause", "clause_path": ["4", "4.1"], "label": "4.1", "text": "4.1 Development shall respect the scale, form and character of its surroundings."}
{"record_id": "r003", "document": "DMP", "version": "v3", "page": 14, "kind": "clause", "clause_path": ["4", "4.2"], "label": "4.2", "text": "4.2 Rear extensions to dwellings are permitted where:"}
{"record_id": "r004", "document": "DMP", "version": "v3", "page": 14, "kind": "clause", "clause_path": ["4", "4.2", "(a)"], "label": "(a)", "text": "(a) the depth does not exceed 4 m;"}
{"record_id": "r005", "document": "DMP", "version": "v3", "page": 14, "kind": "clause", "clause_path": ["4", "4.2", "(b)"], "label": "(b)", "text": "(b) the eaves height does not exceed 3 m, except where", "continued_by": "r006"}
{"record_id": "r006", "document": "DMP", "version": "v3", "page": 15, "kind": "clause", "clause_path": ["4", "4.2", "(b)"], "label": "(b)", "text": "the site lies within a Conservation Area, where the eaves height does not exceed 2.5 m.7", "continues": "r005", "footnote_refs": ["7"]}
{"record_id": "r007", "document": "DMP", "version": "v3", "page": 15, "kind": "clause", "clause_path": ["4", "4.3"], "label": "4.3", "text": "4.3 Side extensions to dwellings are permitted where:"}
{"record_id": "r008", "document": "DMP", "version": "v3", "page": 15, "kind": "clause", "clause_path": ["4", "4.3", "(a)"], "label": "(a)", "text": "(a) the extension is set back at least 1 m from the front elevation;"}
{"record_id": "r009", "document": "DMP", "version": "v3", "page": 15, "kind": "clause", "clause_path": ["4", "4.3", "(b)"], "label": "(b)", "text": "(b) the depth does not exceed 4 m;"}
{"record_id": "r010", "document": "DMP", "version": "v3", "page": 15, "kind": "clause", "clause_path": ["4", "4.3", "(c)"], "label": "(c)", "text": "(c) a gap of at least 1 m is kept to the side boundary."}
{"record_id": "r011", "document": "DMP", "version": "v3", "page": 15, "kind": "footnote", "clause_path": [], "label": "7", "text": "7 Conservation Area boundaries are shown on the Policies Map, Inset 3 (page 18).", "footnote_id": "7"}
