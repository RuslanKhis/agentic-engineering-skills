diff --git a/.github_workflows_ci.yml b/.github_workflows_ci.yml
index 100aaad..b01ed9f 100644
--- a/.github_workflows_ci.yml
+++ b/.github_workflows_ci.yml
@@ -1,8 +1,56 @@
 name: ci
-on: [push, pull_request]
+on:
+  push:
+  pull_request:
+    types: [opened, synchronize, labeled]
+  workflow_dispatch:
 jobs:
   test:
     runs-on: ubuntu-latest
     steps:
       - uses: actions/checkout@v4
       - run: pip install -e . pytest && pytest
+
+  # Tier 2 live eval gate (T-103). Agent inference only, no judge. Opt-in until the
+  # runner can reach the tool backends; see docs/releases/T-103-model-upgrade.md.
+  # `adk eval` exits 0 whatever the scores, so the gate is pytest + AgentEvaluator
+  # (averaging) followed by the strict per-run CSV checker. A missing CSV fails the job.
+  live-eval:
+    needs: test
+    if: >-
+      github.event_name == 'workflow_dispatch' ||
+      contains(github.event.pull_request.labels.*.name, 'run-live-eval')
+    runs-on: ubuntu-latest
+    environment: eval
+    env:
+      EVAL_LIVE: "1"
+      EVAL_NUM_RUNS: "3"
+      EVAL_MAX_CASES: "120"
+      EVAL_MAX_RUNS: "3"
+      EVAL_OUTPUT_CSV: results/${{ github.sha }}/ci.csv
+      ADK_AGENT_EVALUATION_DIR: .claude/skills/adk-agent-evaluation
+      GOOGLE_API_KEY: ${{ secrets.GOOGLE_API_KEY }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+      - run: pip install -e . pytest
+      - name: Run AgentEvaluator with repeats and CSV output
+        run: |
+          mkdir -p "$(dirname "$EVAL_OUTPUT_CSV")"
+          python -m pytest tests/eval/test_ci_gate.py -q || echo "AGENT_EVALUATOR_FAILED=1" >> "$GITHUB_ENV"
+      - name: Strict gate over per-run rows (NOT RUN is a failure)
+        run: |
+          test -s "$EVAL_OUTPUT_CSV" || { echo "::error::No CSV produced: eval NOT RUN"; exit 1; }
+          python "$ADK_AGENT_EVALUATION_DIR/scripts/check_eval_results.py" --csv "$EVAL_OUTPUT_CSV" --expectations evals/ci-expectations.json
+      - name: Fail when the averaging gate failed
+        if: env.AGENT_EVALUATOR_FAILED == '1'
+        run: |
+          echo "::error::AgentEvaluator reported failures (mean over $EVAL_NUM_RUNS runs below threshold)"
+          exit 1
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: eval-evidence-${{ github.sha }}
+          path: results/${{ github.sha }}
