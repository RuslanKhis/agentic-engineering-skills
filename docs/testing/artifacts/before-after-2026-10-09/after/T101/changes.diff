diff --git a/tests/test_tools.py b/tests/test_tools.py
index 839f566..231947b 100644
--- a/tests/test_tools.py
+++ b/tests/test_tools.py
@@ -3,3 +3,75 @@ from support_agent import tools
 
 def test_orders_api_constant():
     assert tools.ORDERS_API.startswith("https://")
+
+
+import httpx
+import pytest
+
+
+class _Resp:
+    def __init__(self, status_code, payload):
+        self.status_code = status_code
+        self._payload = payload
+
+    def json(self):
+        return self._payload
+
+
+def _record_get(monkeypatch, status_code=200, payload=None):
+    calls = []
+
+    def fake_get(url, **kwargs):
+        calls.append((url, kwargs))
+        return _Resp(status_code, payload)
+
+    monkeypatch.setattr(tools.httpx, "get", fake_get)
+    return calls
+
+
+@pytest.mark.parametrize("order_id", ["A10023", "ORD-123456", " 98765 "])
+def test_get_order_accepts_order_ids(monkeypatch, order_id):
+    calls = _record_get(monkeypatch, payload={"status": "shipped"})
+    result = tools.get_order(order_id)
+    assert result == {"status": "success", "order_id": order_id.strip(), "order": {"status": "shipped"}}
+    assert calls[0][0] == f"{tools.ORDERS_API}/orders/{order_id.strip()}"
+
+
+@pytest.mark.parametrize("value", ["Jane Smith", "Smith", "jane.smith@example.com", "", "../refunds"])
+def test_get_order_rejects_names_without_calling_the_api(monkeypatch, value):
+    calls = _record_get(monkeypatch)
+    result = tools.get_order(value)
+    assert result["status"] == "error"
+    assert result["retryable"] is False
+    assert "search_orders" in result["hint"]
+    assert calls == []
+
+
+def test_get_order_not_found_returns_hint(monkeypatch):
+    _record_get(monkeypatch, status_code=404)
+    result = tools.get_order("A10023")
+    assert result["status"] == "error" and result["retryable"] is False
+    assert "Confirm the order ID" in result["hint"]
+
+
+def test_get_order_unavailable_is_retryable(monkeypatch):
+    def boom(url, **kwargs):
+        raise httpx.ConnectTimeout("timeout")
+
+    monkeypatch.setattr(tools.httpx, "get", boom)
+    result = tools.get_order("A10023")
+    assert result["status"] == "error" and result["retryable"] is True
+
+
+def test_search_orders_passes_query(monkeypatch):
+    calls = _record_get(monkeypatch, payload=[{"order_id": "A10023"}])
+    result = tools.search_orders("Jane Smith")
+    assert result == {"status": "success", "orders": [{"order_id": "A10023"}]}
+    assert calls[0][1]["params"] == {"q": "Jane Smith"}
+
+
+def test_order_tool_docstrings_name_each_other():
+    # On google-adk 2.8.0 the docstring is the whole model-facing description.
+    assert "search_orders" in tools.get_order.__doc__
+    assert "get_order" in tools.search_orders.__doc__
+    assert tools.get_order.__doc__.startswith("Fetch one order by its order ID")
