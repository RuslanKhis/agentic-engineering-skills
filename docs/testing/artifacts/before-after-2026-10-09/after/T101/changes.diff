+def search_orders(query: str) -> dict:
+    """Search for a customer's orders by customer name, e-mail address or a description of the purchase.
+
+    Use this tool ONLY when the customer has NOT given an order ID, for example
+    "my orders from last month" or "the order for Jane Smith". If the customer
+    gives an order ID, call get_order instead; do not search for an order ID.
+
+    Args:
+        query: Free text identifying the customer or purchase, for example
+            "Jane Smith", "jane.smith@example.com" or "blue kettle March".
+
+    Returns:
+        On success, status is "success" and "orders" holds the matches; each
+        match carries the "order_id" to pass to get_order.
+        On failure, status is "error" with "error" and "hint".
+        Example success: {"status": "success", "orders": [{"order_id": "A10023", "status": "shipped"}]}
+        Example error: {"status": "error", "error": "order service unavailable", "hint": "Tell the customer the order system is temporarily unavailable.", "retryable": true}
+    """
+    try:
+        resp = httpx.get(f"{ORDERS_API}/orders", params={"q": query}, timeout=10)
+    except httpx.HTTPError:
+        return _orders_unavailable()
+    if resp.status_code != 200:
+        return _orders_unavailable()
     return {"status": "success", "orders": resp.json()}
 
 
-def get_order(data: str) -> dict:
-    """Get an order."""
-    resp = httpx.get(f"{ORDERS_API}/orders/{data}", timeout=10)
-    return {"status": "success", "order": resp.json()}
+def get_order(order_id: str) -> dict:
+    """Fetch one order by its order ID and return its current details.
+
+    Use this tool whenever the customer gives an order ID (for example "A10023"
+    or "ORD-123456"). Pass the ID exactly as the customer wrote it. Never pass a
+    customer name or e-mail address here; when no order ID is known, call
+    search_orders to find it first.
+
+    Args:
+        order_id: The order ID, a single word of letters, digits, "-" or "_"
+            that contains at least one digit, for example "A10023".
+
+    Returns:
+        On success, status is "success" with "order_id" and the "order" details.
+        On failure, status is "error" with "error", "hint" and "retryable".
+        Example success: {"status": "success", "order_id": "A10023", "order": {"status": "shipped"}}
+        Example error: {"status": "error", "error": "'Jane Smith' is not an order ID", "hint": "Ask the customer for the order ID, or call search_orders with their name.", "retryable": false}
+    """
+    order_id = order_id.strip()
+    if not ORDER_ID.fullmatch(order_id):
+        return {
+            "status": "error",
+            "error": f"{order_id!r} is not an order ID",
+            "hint": "Ask the customer for the order ID, or call search_orders "
+                    "with their name or e-mail address. Do not guess an ID.",
+            "retryable": False,
+        }
+    try:
+        resp = httpx.get(f"{ORDERS_API}/orders/{order_id}", timeout=10)
+    except httpx.HTTPError:
+        return _orders_unavailable()
+    if resp.status_code == 404:
+        return {
+            "status": "error",
+            "error": f"no order with ID {order_id!r}",
+            "hint": "Confirm the order ID with the customer; a typo is likely. "
+                    "If they do not have it, call search_orders.",
+            "retryable": False,
+        }
+    if resp.status_code != 200:
+        return _orders_unavailable()
+    return {"status": "success", "order_id": order_id, "order": resp.json()}
+
+
+def _orders_unavailable() -> dict:
+    return {
+        "status": "error",
+        "error": "order service unavailable",
+        "hint": "Tell the customer the order system is temporarily unavailable. "
+                "Do not call this tool again in this turn.",
+        "retryable": True,
+    }
 
 
