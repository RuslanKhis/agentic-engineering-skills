MODEL_ID=gemini-3.5-flash
SUPPORT_DB_PATH=/tmp/support.db
PAYMENTS_BASE_URL=https://payments.example.invalid/v1
MAIL_BASE_URL=https://mail.example.invalid/api
# Telemetry. Do not redeploy with these until telemetry.googleapis.com is enabled and the
# runtime identity holds roles/telemetry.writer (see docs/observability.md, "Approvals").
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
# Keep prompts, responses and tool arguments out of spans: 2.8.0 captures them unless this is false or 0.
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# Needed for the adk.experimental.* token metrics; remove if experimental names are unwanted.
ADK_EXPERIMENTAL_TELEMETRY=true
