      "def language_for(self, owner):",
      "    with self.lock:",
      "        row = self.db.execute(",
      "            \"SELECT language FROM preferences \"",
      "            \"WHERE owner = ?\", (owner,)",
      "        ).fetchone()",
      "    return row[0] if row else \"English\""
    ]
